{
  "name": "dogara",
  "productName": "Dōgara",
  "version": "0.1.0",
  "private": true,
  "description": "App de escritorio open source que abre YouTube en su propia ventana y le suma funciones. No afiliada a Google ni a YouTube.",
  "homepage": "https://github.com/RicknotDev/dogara",
  "author": {
    "name": "ricky y nellys",
    "email": "RicknotDev@users.noreply.github.com"
  },
  "license": "GPL-3.0-only",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
